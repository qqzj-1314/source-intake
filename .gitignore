# Only distribute product sources, tests and portable documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/install.ps1
!/plugin/
!/skill/
!/tests/
!/scripts/
!/docs/
!/CHANGELOG.md
!/.claude-plugin/
!/integrations/
!/.github/
**/node_modules/
**/.local/
**/__pycache__/
**/*.pyc
**/.source-intake/
**/panel-settings.json
**/.env
**/.env.*
